{
  "version": 2,
  "rewrites": [
    { "source": "/api/payments/:path*", "destination": "/api/payments?path=:path*" },
    { "source": "/api/coop-b2b/:path*", "destination": "/api/coop-b2b?path=:path*" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/ai.ts": {
      "maxDuration": 60
    }
  }
}