{
  "version": 2,
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/zk", "destination": "/api/zkteco-webhook" },
    { "source": "/zk/:path*", "destination": "/api/zkteco-webhook" },
    { "source": "/adms", "destination": "/api/zkteco-webhook" },
    { "source": "/adms/:path*", "destination": "/api/zkteco-webhook" },
    { "source": "/iclock", "destination": "/api/zkteco-webhook" },
    { "source": "/iclock/:path*", "destination": "/api/zkteco-webhook" },
    { "source": "/api/payments/:path*", "destination": "/api/payments?path=:path*" },
    { "source": "/api/coop-b2b/:path*", "destination": "/api/coop-b2b?path=:path*" },
    { "source": "/webhook/whatsapp", "destination": "/api/whatsapp-webhook" },
    { "source": "/whatsapp-webhook", "destination": "/api/whatsapp-webhook" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "build": {
    "env": {
      "NODE_OPTIONS": "--no-deprecation"
    }
  },
  "functions": {
    "api/ai.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/records.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron-billing",
      "schedule": "0 0 * * *"
    }
  ]
}