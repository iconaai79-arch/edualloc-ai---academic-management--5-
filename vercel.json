{
  "version": 2,
  "rewrites": [
    { "source": "/iclock/:path*", "destination": "/api/zkteco-webhook" },
    { "source": "/api/payments/:path*", "destination": "/api/payments?path=:path*" },
    { "source": "/api/coop-b2b/:path*", "destination": "/api/coop-b2b?path=:path*" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/ai.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-billing",
      "schedule": "0 0 * * *"
    }
  ]
}