<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="timetable"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_eduai"
        android:shortcutShortLabel="@string/shortcut_timetable"
        android:shortcutLongLabel="@string/shortcut_timetable_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.eduai.academic"
            android:targetClass="com.eduai.academic.MainActivity"
            android:data="eduai://timetable" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_eduai"
        android:shortcutShortLabel="@string/shortcut_scan"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.eduai.academic"
            android:targetClass="com.eduai.academic.MainActivity"
            android:data="eduai://scan" />
    </shortcut>
</shortcuts>
