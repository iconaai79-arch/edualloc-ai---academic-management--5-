{
  "name": "eduai-academic-management",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "seed:counties": "node database/seed_kenyan_admin_units.js",
    "migrate": "node database/run_migration_direct.js",
    "migrate:master": "node database/run_migration_direct.js eduai_master_schema.sql",
    "migrate:schema": "node database/run_migration_direct.js eduai_master_schema.sql",
    "migrate:library": "node database/run_migration_direct.js library_management_update.sql",
    "migrate:boarding": "node database/run_migration_direct.js migrations/002_boarding_management.sql",
    "upload:showcase": "node scripts/upload_showcase_ftp.js",
    "android:init": "cap init eduai-academic-management com.eduai.academic --web-dir=dist",
    "android:add": "cap add android",
    "android:sync": "vite build && cap sync",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capgo/capacitor-native-biometric": "^8.4.11",
    "@google/generative-ai": "^0.21.0",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^8.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/node": "^5.5.16",
    "basic-ftp": "^5.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.576.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-webcam": "^7.2.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "body-parser": "^2.2.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "core-js": true,
    "esbuild": true,
    "tesseract.js": true
  }
}
